PORT=4000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Base de datos (configurar cuando se instale PostgreSQL)
DATABASE_URL=postgresql://atlas:password@localhost:5432/atlas_dev

# JWT
JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis (configurar cuando se instale Redis)
REDIS_URL=redis://localhost:6379
